# Copy to .env (git-ignored). All values are optional; sane defaults apply.

# Where the SQLite database lives.
INSIGHTPULSE_DB=artifacts/insightpulse.db

# Comma-separated browser origins allowed to call the API.
INSIGHTPULSE_CORS_ORIGINS=http://localhost:5173

# Compiled dashboard directory (served at / when present).
INSIGHTPULSE_FRONTEND_DIST=frontend/dist

# Per-task trained models. Any task without one uses the transparent lexicon.
# INSIGHTPULSE_SENTIMENT_MODEL_PATH=models/dynasent-sentiment.joblib
# INSIGHTPULSE_ASPECT_MODEL_PATH=models/cfpb-aspect.joblib
# INSIGHTPULSE_INTENT_MODEL_PATH=
# INSIGHTPULSE_SHADOW_MODEL_PATH=

# Multi-task baseline (back-compat): serves every task it was trained on.
# INSIGHTPULSE_MODEL_PATH=

# Server port (containers/hosts usually inject this).
PORT=8000
